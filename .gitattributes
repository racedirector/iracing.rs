*.ibt filter=lfs diff=lfs merge=lfs -text

# Normalize all text files to LF in the repo
* text=auto eol=lf

# Windows-specific scripts can stay CRLF if needed
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must be LF
*.sh text eol=lf

# Binary files (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary